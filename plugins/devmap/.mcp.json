{
  "mcpServers": {
    "devmap": {
      "command": "npx",
      "args": [
        "--yes",
        "devmap-cli@0.1.1",
        "mcp"
      ],
      "enabled": true,
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 10,
      "default_tools_approval_mode": "writes",
      "tools": {
        "devmap_read_map": {
          "approval_mode": "auto"
        },
        "devmap_open_map": {
          "approval_mode": "auto"
        }
      }
    }
  }
}
