        <mxCell id="query" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;统一查询与投影&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;generation + evaluated_at&lt;br&gt;各来源 freshness / warnings&lt;br&gt;摘要优先、历史分页&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="990" y="545" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="durable" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;必须保留&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;事件、路线修订、关联历史、水位&lt;br&gt;迁移溯源；外部一致性备份&lt;br&gt;损坏时停止写入并恢复&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e4;strokeColor=#c49245;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="50" y="770" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;可以重新生成&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;当前 presence、Git 当前快照&lt;br&gt;从事实来源或持久记录重算&lt;br&gt;过期不代表完成&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f6;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="520" y="770" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="clients" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;地图 / MCP / CLI&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;同一查询契约，按需展示详情&lt;br&gt;写命令回到统一接入层&lt;br&gt;浏览器首轮只读&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff0fc;strokeColor=#9295c8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="990" y="770" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;span style=&quot;font-size:20px;font-weight:700&quot;&gt;运行方式&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;每仓库一个按需共享写核心；多个代理可连接。SQLite 替代多文件协议，不替代 Git。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f6;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="50" y="940" width="1340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="migration" name="03 存储迁移与回退边界">
    <mxGraphModel dx="1440" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1090" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="存储迁移与回退边界" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=38;fontColor=#172c43;">
          <mxGeometry x="50" y="60" width="1340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="建议流程 · 影子验证先行，最终切换重新冻结 · 不长期双写" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172c43;">
          <mxGeometry x="50" y="117" width="1340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="freeze" target="backup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backup" target="import">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="import" target="verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="verify" target="activate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=1.0;exitY=0.496;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="verify" target="failure">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="737" />
              <mxPoint x="835" y="495" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="freeze" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;1  停止旧写入并冻结&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;确认旧插件、hook、CLI 和后台都已停止写入&lt;br&gt;检查 pending intent；不一致时停止并保留原始副本&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="60" y="165" width="730" height="125" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;2  创建外部备份&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;备份旧日志、路线、关联水位和必要 Context 对象&lt;br&gt;保存源哈希与清单；备份放在 Git 目录之外&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="60" y="335" width="730" height="125" as="geometry" />
        </mxCell>
        <mxCell id="import" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;3  导入临时 SQLite&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;保留原 ID、修订、时间、来源与记录哈希&lt;br&gt;导入可重试；无法验证的记录不能当作成功&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="60" y="505" width="730" height="125" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;4  验证完整性和领域等价&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;数据库完整性 + 外键 + 持久记录去向 + 语义对照&lt;br&gt;未解释差异为 0；确认最终源哈希未变&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="60" y="675" width="730" height="125" as="geometry" />
        </mxCell>
        <mxCell id="activate" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;5  发布新库并切换写核心&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;关闭临时库句柄，发布一致库；确认客户端版本&lt;br&gt;旧写入口退役；原备份保留&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3ee;strokeColor=#30916c;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="60" y="845" width="730" height="125" as="geometry" />
        </mxCell>
        <mxCell id="shadow" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P2 影子验证&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;此前只从冻结副本试导入&lt;br&gt;旧系统仍是唯一权威写路径&lt;br&gt;最终切换必须重新导入最新数据&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#6488c1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="890" y="165" width="480" height="155" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;验证失败：停止切换&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;保留旧存储与临时库诊断&lt;br&gt;修复导入器后重新验证&lt;br&gt;不删除旧数据、不自动清空&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e4;strokeColor=#c49245;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="890" y="420" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rollback" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;回退分界&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;新库尚未接受写入：&lt;br&gt;可恢复旧存储为权威&lt;br&gt; &lt;br&gt;新库已经确认新记录：&lt;br&gt;先验证反向导出覆盖所有新记录&lt;br&gt;不能无损表达时保持只读并前向修复&lt;br&gt;禁止直接退回旧快照&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e4;strokeColor=#c49245;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="890" y="675" width="480" height="295" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="roadmap" name="04 DevMap 技术路线图">
    <mxGraphModel dx="1440" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1050" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DevMap 技术路线图" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=38;fontColor=#172c43;">
          <mxGeometry x="50" y="60" width="1340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="建议阶段 · 所有阶段待实施 · 以验收门槛推进，不承诺未经测量的工期" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#172c43;">
          <mxGeometry x="50" y="117" width="1340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=1.0;exitY=0.49795918367346936;exitDx=0;exitDy=0;entryX=0.0;entryY=0.49795918367346936;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=1.0;exitY=0.49795918367346936;exitDx=0;exitDy=0;entryX=0.0;entryY=0.49795918367346936;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="等价通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.0;exitY=0.49795918367346936;exitDx=0;exitDy=0;entryX=1.0;entryY=0.49795918367346936;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#f8fafc;exitX=0.0;exitY=0.49795918367346936;exitDx=0;exitDy=0;entryX=1.0;entryY=0.49795918367346936;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P0  固定基线&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;盘点运行时与实际数据&lt;br&gt;冻结关键语义样本&lt;br&gt;记录打开步骤和性能基线&lt;br&gt; &lt;br&gt;门槛：每类持久记录都有去向&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="50" y="180" width="400" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P1  SQLite 基础&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;受限存储接口与 schema&lt;br&gt;事务、幂等、版本检查&lt;br&gt;一致性备份与恢复&lt;br&gt; &lt;br&gt;门槛：故障检查与构建通过&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="520" y="180" width="400" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P2  影子导入&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;旧系统继续权威写入&lt;br&gt;冻结副本导入，完整保留水位&lt;br&gt;新旧领域输出逐项比较&lt;br&gt; &lt;br&gt;门槛：未解释语义差异为 0&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#6488c1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="990" y="180" width="400" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P3  共享核心&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;互斥启动、身份与版本握手&lt;br&gt;串行写入，多客户端读取&lt;br&gt;重连核对和来源 freshness&lt;br&gt; &lt;br&gt;门槛：一个仓库一个写核心&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="990" y="555" width="400" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:21px;font-weight:700;line-height:25px;color:#172c43&quot;&gt;P4  简化使用&lt;/div&gt;&lt;div style=&quot;margin-top:2px;line-height:24px;font-size:17px;color:#40526a&quot;&gt;一个日常打开动作&lt;br&gt;UI / MCP / CLI 统一结果&lt;br&gt;真实宿主及发布构件验证&lt;br&gt; &lt;br&gt;门槛：可用性与测量证据通过&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;fontFamily=Microsoft YaHei;fontSize=17;arcSize=10;">
          <mxGeometry x="520" y="555" width="400" height="245" as="geometry" />
        </mxCell>
