    {
      "id": "migration",
      "file": "03-migration",
      "title": "存储迁移与回退边界",
      "subtitle": "建议流程 · 影子验证先行，最终切换重新冻结 · 不长期双写",
      "width": 1440,
      "height": 1090,
      "nodes": [
        {
          "id": "freeze",
          "x": 60,
          "y": 165,
          "w": 730,
          "h": 125,
          "title": "1  停止旧写入并冻结",
          "lines": [
            "确认旧插件、hook、CLI 和后台都已停止写入",
            "检查 pending intent；不一致时停止并保留原始副本"
          ],
          "kind": "normal"
        },
        {
          "id": "backup",
          "x": 60,
          "y": 335,
          "w": 730,
          "h": 125,
          "title": "2  创建外部备份",
          "lines": [
            "备份旧日志、路线、关联水位和必要 Context 对象",
            "保存源哈希与清单；备份放在 Git 目录之外"
          ],
          "kind": "normal"
        },
        {
          "id": "import",
          "x": 60,
          "y": 505,
          "w": 730,
          "h": 125,
          "title": "3  导入临时 SQLite",
          "lines": [
            "保留原 ID、修订、时间、来源与记录哈希",
            "导入可重试；无法验证的记录不能当作成功"
          ],
          "kind": "normal"
        },
        {
          "id": "verify",
          "x": 60,
          "y": 675,
          "w": 730,
          "h": 125,
          "title": "4  验证完整性和领域等价",
          "lines": [
            "数据库完整性 + 外键 + 持久记录去向 + 语义对照",
            "未解释差异为 0；确认最终源哈希未变"
          ],
          "kind": "normal"
        },
        {
          "id": "activate",
          "x": 60,
          "y": 845,
          "w": 730,
          "h": 125,
          "title": "5  发布新库并切换写核心",
          "lines": [
            "关闭临时库句柄，发布一致库；确认客户端版本",
            "旧写入口退役；原备份保留"
          ],
          "kind": "store"
        },
        {
          "id": "shadow",
          "x": 890,
          "y": 165,
          "w": 480,
          "h": 155,
          "title": "P2 影子验证",
          "lines": [
            "此前只从冻结副本试导入",
            "旧系统仍是唯一权威写路径",
            "最终切换必须重新导入最新数据"
          ],
          "kind": "accent"
        },
        {
          "id": "failure",
          "x": 890,
          "y": 420,
          "w": 480,
          "h": 150,
          "title": "验证失败：停止切换",
          "lines": [
            "保留旧存储与临时库诊断",
            "修复导入器后重新验证",
            "不删除旧数据、不自动清空"
          ],
          "kind": "warning"
        },
        {
          "id": "rollback",
          "x": 890,
          "y": 675,
          "w": 480,
          "h": 295,
          "title": "回退分界",
          "lines": [
            "新库尚未接受写入：",
            "可恢复旧存储为权威",
            " ",
            "新库已经确认新记录：",
            "先验证反向导出覆盖所有新记录",
            "不能无损表达时保持只读并前向修复",
            "禁止直接退回旧快照"
          ],
          "kind": "warning"
        }
      ],
